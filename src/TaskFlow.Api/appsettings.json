{
  "Jwt": {
    "Issuer": "TaskFlowApi",
    "Audience": "TaskFlowClient"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=TaskFlowDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Cors": {
    "Origins": []
  },
  "Database": {
    "AutoMigrate": true
  },
  "Demo": {
    "Enabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
