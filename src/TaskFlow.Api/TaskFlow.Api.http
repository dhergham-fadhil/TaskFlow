@TaskFlow.Api_HostAddress = http://localhost:5187

### Authentication
POST {{TaskFlow.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "user@example.com",
  "password": "SecurePassword123!"
}

###

POST {{TaskFlow.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "name": "Demo User",
  "email": "user@example.com",
  "password": "SecurePassword123!"
}

###

GET {{TaskFlow.Api_HostAddress}}/api/users/me
Authorization: Bearer {{token}}

###

### Workspace
GET {{TaskFlow.Api_HostAddress}}/api/workspace
Authorization: Bearer {{token}}

###

### Projects
GET {{TaskFlow.Api_HostAddress}}/api/projects?page=1&pageSize=50
Authorization: Bearer {{token}}

###

POST {{TaskFlow.Api_HostAddress}}/api/projects
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "New Project",
  "description": "Project description",
  "color": "#6D5EF8",
  "icon": "rocket",
  "status": "active",
  "dueDate": null,
  "memberIds": []
}

###

PUT {{TaskFlow.Api_HostAddress}}/api/projects/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Updated Project"
}

###

### Tasks
GET {{TaskFlow.Api_HostAddress}}/api/tasks?page=1&pageSize=50
Authorization: Bearer {{token}}

###

POST {{TaskFlow.Api_HostAddress}}/api/tasks
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "New Task",
  "description": "Task description",
  "projectId": 1,
  "status": "backlog",
  "priority": "medium",
  "assigneeId": null,
  "labels": [],
  "dueDate": null,
  "subtasks": []
}

###

PUT {{TaskFlow.Api_HostAddress}}/api/tasks/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "Updated Task",
  "status": "in_progress"
}

###

POST {{TaskFlow.Api_HostAddress}}/api/tasks/1/move
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "status": "done",
  "index": 0
}

###

POST {{TaskFlow.Api_HostAddress}}/api/tasks/1/comments
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "body": "This is a comment"
}

###

DELETE {{TaskFlow.Api_HostAddress}}/api/tasks/1
Authorization: Bearer {{token}}

###
